generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id               String   @id @default(cuid())
  fullName         String
  phoneNumber      String
  emailAddress     String?
  treatment        String?
  preferredLocation String
  preferredDate    String?
  message          String?
  createdAt        DateTime @default(now())
  status           String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String   @db.Text
  content   String   @db.Text
  author    String   @default("Dr. Ramesh Kumar")
  image     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BeforeAfterCase {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("General") // Dental Implants, Smile Makeover, Invisalign, Braces, etc.
  beforeImage String   @db.Text
  afterImage  String   @db.Text
  isFeatured  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteMedia {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "hero_home", "hero_root_canal", "hero_braces", "hero_implants", "banner_promo"
  label     String   // Human readable label e.g. "Homepage Hero Photo"
  imageUrl  String   @db.Text
  updatedAt DateTime @updatedAt
}

